# Local development only. Railway supplies PORT automatically; do not set a fixed PORT there.
PORT=4000
SITE_B_BASE_URL=http://localhost:4000

# Public Phantom Cards URL used by the existing Site A payment callbacks.
SITE_A_BASE_URL=http://localhost:3000

# These two secrets must match the values in the Phantom Cards .env.
# They preserve the existing Site A ↔ Site B payment-service contract.
SITE_A_TO_SITE_B_SECRET=replace_with_the_same_long_secret_as_phantom_cards
SITE_B_TO_SITE_A_SECRET=replace_with_the_same_long_secret_as_phantom_cards_callback

# Paystack is used only from this server. Never put this in public/app.js.
PAYSTACK_SECRET_KEY=sk_test_replace_me
# npm run dev uses this key instead of PAYSTACK_SECRET_KEY. A live key is
# deliberately ignored in development to prevent accidental real charges.
PAYSTACK_TEST_SECRET_KEY=sk_test_replace_me
PAYSTACK_API_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=GHS

# Separate storage from Phantom Cards data.
# Railway: mount the volume at /app/data and keep these paths inside that volume.
# Local development: use ./data/payment-service.json and ./data/data-bundles.json instead.
PAYMENT_DATA_FILE=/app/data/payment-service.json
DATA_BUNDLE_DATA_FILE=/app/data/data-bundles.json

# Durable Site A callback retry and provider reconciliation workers.
# Defaults are 30 seconds for callback retries and 60 seconds for provider checks.
CALLBACK_RETRY_INTERVAL_MS=30000
CALLBACK_RETRY_INITIAL_DELAY_MS=30000
PAYMENT_RECONCILIATION_INTERVAL_MS=60000

# Use a Paystack-approved test email for bundle checkout receipts.
DATA_BUNDLE_PAYMENT_EMAIL=danny700218+1@gmail.com

# Private token for the manual fulfillment API.
DATA_BUNDLE_ADMIN_TOKEN=replace_with_a_long_random_private_token
